# Copy to .env and fill secrets. NEVER commit .env.

# --- Required secrets ---
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=master-data-vectors

# --- Models ---
GEMINI_USE=true
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
GEMINI_TEXT_MODEL_NAME=gemini-3.1-flash-lite
GEMINI_CALL_TIMEOUT_SEC=30
GEMINI_MAX_OUTPUT_TOKENS=2000
GEMINI_DEFAULT_OUTPUT_TOKENS=500

# --- Images ---
ASSET_IMAGE_MAX_EDGE=896
BARCODE_IMAGE_MAX_EDGE=768
IMAGE_JPEG_QUALITY=80
BLANK_IMAGE_GATE_ENABLED=false

# --- Payload guards (HTTP) ---
MAX_REQUEST_BODY_BYTES=26214400
MAX_IMAGE_BYTES=12582912
MAX_ASSET_NAME_CHARS=500
MAX_DESCRIPTION_CHARS=2000
MAX_TAG_NUMBER_CHARS=128
MIN_IMAGE_BYTES=32

# --- Pipeline flags ---
PHASE2_IMAGE_ANALYSIS_MAX_CHARS=350
CONDITION_DETAIL_LEVEL=minimal
PHASE1_CONTENT_ROUTE_ENABLED=false
BLIND_VIEW_ENABLED=true
PROMPT_HOT_RELOAD=false
PROMPT_CACHE_HOIST=true

# --- Pinecone ---
EMBEDDING_MODEL_NAME=gemini-embedding-001
EMBEDDING_DIMENSION=1536
INCLUDE_PINECONE_LOOKUP=true
PINECONE_TOP_K=10
PINECONE_ASSET_CLASS_SCOPE_ENABLED=true
PINECONE_CATEGORY_SCOPE_ENABLED=true

# --- Transport / logging ---
BARCODE_DECODE_ENABLED=true
ADDITIONAL_ASSET_ACCEPT_MULTIPART=true
ADDITIONAL_ASSET_ACCEPT_JSON=true
ADDITIONAL_ASSET_LOG_CANDIDATES=true
LOG_LEVEL=INFO
DEBUG_LOG_TO_FILE=true
DEBUG_LOG_DIR=debug

# Comma-separated origins for production. "*" disables credentials (local default).
CORS_ALLOW_ORIGINS=*
